+template <typename F>
+class ScopeExit {
+ public:
+  explicit ScopeExit(F callback) : callback_(std::move(callback)) {}
+  ScopeExit(const ScopeExit&) = delete;
+  ScopeExit& operator=(const ScopeExit&) = delete;
+  ~ScopeExit() { callback_(); }
+
+ private:
+  F callback_;
+};
+
+template <typename F>
+ScopeExit<F> onScopeExit(F callback) {
+  return ScopeExit<F>(std::move(callback));
+}
