+void MosaicoClient::registerActiveReader(fl::FlightStreamReader* reader) {
+  std::lock_guard<std::mutex> lock(active_readers_mu_);
+  active_readers_.insert(reader);
+}
+
+void MosaicoClient::unregisterActiveReader(fl::FlightStreamReader* reader) {
+  std::lock_guard<std::mutex> lock(active_readers_mu_);
+  active_readers_.erase(reader);
+}
+
+void MosaicoClient::cancelActivePulls() {
+  // FlightStreamReader::Cancel delegates to gRPC ClientContext::TryCancel and
+  // is expressly intended for watchdog/background-thread cancellation. Keep
+  // the registry locked so a reader cannot be destroyed during this call.
+  std::lock_guard<std::mutex> lock(active_readers_mu_);
+  for (auto* reader : active_readers_) {
+    reader->Cancel();
+  }
+}
