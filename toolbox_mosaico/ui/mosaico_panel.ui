<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MosaicoPanel</class>
 <widget class="QWidget" name="MosaicoPanel">
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing"><number>0</number></property>
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>

   <!-- Server header band: the canonical SectionHeaderBand (host-promoted) in
        "label + input" mode: the editable URL combo expands to fill the band,
        with the Connect / Cert icon buttons docked on the right. Height +
        paddings come from the framework (ChromeMetrics.bandHeight, wired to the
        app's chrome-metrics broadcast by the host). -->
   <item>
    <widget class="SectionHeaderBand" name="serverHeaderBand">
     <property name="text"><string>Server:</string></property>
     <property name="comboExpanding"><bool>true</bool></property>
     <property name="comboEditable"><bool>true</bool></property>
     <property name="trailingComboName"><string>comboUri</string></property>
     <property name="trailingButtonNames">
      <stringlist>
       <string>buttonConnect</string>
       <string>buttonCert</string>
      </stringlist>
     </property>
     <property name="trailingButtonToolTips">
      <stringlist>
       <string>Connect</string>
       <string>Cert / API Key&#8230;</string>
      </stringlist>
     </property>
    </widget>
   </item>

   <!-- 1px divider between the Server header container and the rest of the panel. -->
   <item>
    <widget class="QFrame" name="serverSeparator">
     <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
     <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
    </widget>
   </item>

   <!-- Body: the band is full-bleed; the content below keeps the original
        10px inset via this wrapper so only the header changed. -->
   <item>
    <widget class="QWidget" name="mosaicoBody" native="true">
     <layout class="QVBoxLayout" name="bodyLayout">
      <!-- spacing 0 so the splitter's vertical column handles meet the bottom
           separator (and the separator the duration row) flush: a 2px gap here
           left the handles a couple of pixels short of the separator. -->
      <property name="spacing"><number>0</number></property>
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>

   <!-- Three-column splitter: Sequences | Topics | Info -->
   <item>
    <widget class="QSplitter" name="mainSplitter">
     <!-- Fill the body's vertical space (verstretch) so the duration row below stays a
          compact strip pinned to the bottom instead of the row absorbing the slack. -->
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy>
     </property>
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>

     <!-- ============ SEQUENCES COLUMN ============ -->
     <!-- QFrame so the app QSS can style it. No box border now: the only
          separators are the two mainSplitter handles between the columns. -->
     <widget class="QFrame" name="seqPanelContainer">
      <layout class="QVBoxLayout" name="seqLayout">
       <property name="spacing"><number>2</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <!-- Canonical section band (host-promoted SectionHeaderBand): title +
             inline canonical Search (inner edit named `seqFilter` for the host
             textChanged binding) + regex toggle + far-right reload. Height and
             paddings come from the framework chrome metrics. -->
        <widget class="SectionHeaderBand" name="seqHeaderBand">
         <property name="text"><string>Sequences</string></property>
         <property name="titleObjectName"><string>seqHeader</string></property>
         <property name="filterPlaceholder"><string>Filter&#8230;</string></property>
         <property name="filterFieldName"><string>seqFilter</string></property>
         <property name="trailingToggleName"><string>seqRegexToggle</string></property>
         <property name="trailingToggleText"><string>.*</string></property>
         <property name="trailingToggleToolTip"><string>Use regular expression</string></property>
         <property name="trailingButtonNames">
          <stringlist>
           <string>buttonReloadSeq</string>
          </stringlist>
         </property>
         <property name="trailingButtonToolTips">
          <stringlist>
           <string>Reload sequences</string>
          </stringlist>
         </property>
        </widget>
       </item>
       <!-- Generic date/time range picker: presets + from/to fields + calendar
            overlay. Wrapped in a margined row so the preset chips don't touch
            the panel edge (8 = the framework's space_comfortable, same as the
            duration row at the bottom). -->
       <item>
        <layout class="QHBoxLayout" name="dateRow">
         <property name="leftMargin"><number>8</number></property>
         <property name="topMargin"><number>0</number></property>
         <property name="rightMargin"><number>8</number></property>
         <property name="bottomMargin"><number>2</number></property>
         <item>
          <widget class="DateRangePicker" name="datePicker">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Preferred"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <!-- Draggable split between sequence rows and the metadata query editor. -->
       <item>
        <widget class="QSplitter" name="seqQuerySplitter">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="childrenCollapsible"><bool>false</bool></property>
         <widget class="QTableWidget" name="seqTable">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>2</verstretch></sizepolicy>
          </property>
          <!-- pjInteriorGrid opts this table into the host's InteriorGridDelegate
               (widget_adapters.cpp), which turns native showGrid OFF and paints interior
               column dividers plus a bottom rule under every row (incl. the last), but NO
               outer-left/right line, so the side edges never double the surrounding header /
               splitter chrome. The #seqTable QSS rule themes the dividers (gridline-color)
               and drops the frame (border:none). -->
          <property name="pjInteriorGrid" stdset="0"><bool>true</bool></property>
          <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
          <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
          <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
          <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
         </widget>
         <widget class="QWidget" name="queryPane" native="true">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy>
          </property>
          <layout class="QVBoxLayout" name="queryPaneLayout">
           <property name="leftMargin"><number>0</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <property name="spacing"><number>2</number></property>
           <item>
            <!-- Canonical section band for the metadata-filter section. -->
            <widget class="SectionHeaderBand" name="metadataFilterHeaderBand">
             <property name="text"><string>Metadata Filter</string></property>
            </widget>
           </item>
           <!-- Key/Op/Value assist dropdowns build one clause, committed by +.
                Side margins keep the combos off the panel edge (the band above
                stays full-bleed by design). -->
           <item>
            <layout class="QHBoxLayout" name="queryAssistRow">
             <property name="leftMargin"><number>8</number></property>
             <property name="rightMargin"><number>8</number></property>
             <item>
              <widget class="PJ::ComboBox" name="keyCombo">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy>
               </property>
               <property name="placeholderText"><string>Key</string></property>
              </widget>
             </item>
             <item>
              <widget class="PJ::ComboBox" name="opCombo">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Fixed" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy>
               </property>
               <property name="maximumSize"><size><width>72</width><height>16777215</height></size></property>
               <property name="placeholderText"><string>Op</string></property>
              </widget>
             </item>
             <item>
              <widget class="PJ::ComboBox" name="valCombo">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy>
               </property>
               <property name="placeholderText"><string>Value</string></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="buttonAddClause">
               <property name="text"><string/></property>
               <property name="flat"><bool>true</bool></property>
               <property name="focusPolicy"><enum>Qt::NoFocus</enum></property>
               <property name="minimumSize"><size><width>28</width><height>28</height></size></property>
               <property name="maximumSize"><size><width>28</width><height>28</height></size></property>
               <property name="iconSize"><size><width>24</width><height>24</height></size></property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <layout class="QHBoxLayout" name="luaQueryRow">
             <property name="leftMargin"><number>8</number></property>
             <property name="rightMargin"><number>8</number></property>
             <property name="bottomMargin"><number>8</number></property>
             <item>
              <widget class="QPlainTextEdit" name="lua_queryBar">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy>
               </property>
               <property name="minimumSize"><size><width>0</width><height>72</height></size></property>
               <!-- Background is themed from the host QSS (QPlainTextEdit#lua_queryBar):
                    white in light, ${dark_background} in dark. An inline #ffffff here
                    would override the QSS and render white in dark mode. -->
               <property name="placeholderText"><string>&lt;your_filter_key&gt; &lt;operation&gt; &lt;filter_value&gt;</string></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ============ TOPICS COLUMN ============ -->
     <widget class="QFrame" name="topicPanelContainer">
      <layout class="QVBoxLayout" name="topicLayout">
       <!-- spacing 0: the topic table sits flush under its header band (no gap). -->
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <!-- Canonical section band, same shape as the Sequences band; the reload
             re-lists only the selected sequence's topics. -->
        <widget class="SectionHeaderBand" name="topicHeaderBand">
         <property name="text"><string>Topics</string></property>
         <property name="titleObjectName"><string>topicHeader</string></property>
         <property name="filterPlaceholder"><string>Filter&#8230;</string></property>
         <property name="filterFieldName"><string>topicFilter</string></property>
         <property name="trailingToggleName"><string>topicRegexToggle</string></property>
         <property name="trailingToggleText"><string>.*</string></property>
         <property name="trailingToggleToolTip"><string>Use regular expression</string></property>
         <property name="trailingButtonNames">
          <stringlist>
           <string>buttonReloadTopic</string>
          </stringlist>
         </property>
         <property name="trailingButtonToolTips">
          <stringlist>
           <string>Reload topics</string>
          </stringlist>
         </property>
        </widget>
       </item>
       <!-- Topic-selection mode: All downloads every listed topic (rows go
            inert but the table stays scrollable), Custom downloads the picked
            rows. The radio pair shares topicModeGroup so the host renders it
            as one DualOptionsWidget segment control. -->
       <item>
        <layout class="QHBoxLayout" name="topicModeRow">
         <property name="leftMargin"><number>8</number></property>
         <property name="topMargin"><number>2</number></property>
         <property name="rightMargin"><number>8</number></property>
         <property name="bottomMargin"><number>2</number></property>
         <item>
          <spacer name="topicModeSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
          </spacer>
         </item>
         <item>
          <widget class="QRadioButton" name="radioTopicsAll">
           <property name="text"><string>All</string></property>
           <attribute name="buttonGroup"><string notr="true">topicModeGroup</string></attribute>
          </widget>
         </item>
         <item>
          <widget class="QRadioButton" name="radioTopicsCustom">
           <property name="text"><string>Custom</string></property>
           <property name="checked"><bool>true</bool></property>
           <attribute name="buttonGroup"><string notr="true">topicModeGroup</string></attribute>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QTableWidget" name="topicTable">
         <!-- Same as seqTable: pjInteriorGrid opts into the host InteriorGridDelegate
              (interior column dividers + a bottom rule under every row, no outer-left/right
              line); #topicTable QSS themes the dividers and drops the frame. -->
         <property name="pjInteriorGrid" stdset="0"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::MultiSelection</enum></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ============ INFO COLUMN ============ -->
     <widget class="QFrame" name="dataViewContainer">
      <layout class="QVBoxLayout" name="dataViewLayout">
       <property name="spacing"><number>2</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <!-- Canonical section band for the Info column. -->
        <widget class="SectionHeaderBand" name="infoHeaderBand">
         <property name="text"><string>Info</string></property>
         <property name="titleObjectName"><string>dataViewHeader</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="dataView">
         <property name="readOnly"><bool>true</bool></property>
         <property name="font">
          <font><family>Monospace</family><styleStrategy>PreferDefault</styleStrategy></font>
         </property>
         <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

   <!-- 1px divider between the tables/columns above and the duration row below
        (QFrame#rangeSeparator -> border_default in the QSS, like serverSeparator). -->
   <item>
    <widget class="QFrame" name="rangeSeparator">
     <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
     <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
    </widget>
   </item>

   <!-- Local cache controls (mcap_cloud parity: checkSaveMcap / saveDirectory /
        buttonBrowseSaveDir). Governs whether a Download is recorded as a local
        cache artifact for layout re-import, and where artifacts live. -->
   <item>
    <layout class="QHBoxLayout" name="saveCacheRow">
     <property name="spacing"><number>8</number></property>
     <property name="leftMargin"><number>8</number></property>
     <property name="topMargin"><number>4</number></property>
     <property name="rightMargin"><number>8</number></property>
     <property name="bottomMargin"><number>0</number></property>
     <item>
      <widget class="QCheckBox" name="checkSaveCache">
       <property name="text"><string>Save cache file</string></property>
       <property name="toolTip"><string>Keep this Download's cache file so a saved layout reloads instantly. When unchecked, layouts still record the download instructions, but reopening them downloads from the server again</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="labelCacheDirectory">
       <property name="text"><string>Directory:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="cacheDirectory">
       <property name="placeholderText"><string>Cache directory</string></property>
       <property name="clearButtonEnabled"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="buttonBrowseCacheDir">
       <property name="text"><string>Browse...</string></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Two-handle time range slider + Cancel / Download buttons (PJ3 RangeSlider).
        No in-panel Close: the hosting toolbox banner's close button owns that. -->
   <item>
    <layout class="QHBoxLayout" name="rangeRow">
     <!-- The whole row (duration slider + buttons) floats inside the panel:
          8 = the framework's space_comfortable on the sides/bottom, 4 =
          space_snug on top (the slider's handle-label row already adds
          headroom there). Plugin .ui files cannot reference ${tokens}. -->
     <property name="spacing"><number>8</number></property>
     <property name="leftMargin"><number>8</number></property>
     <property name="topMargin"><number>4</number></property>
     <property name="rightMargin"><number>8</number></property>
     <property name="bottomMargin"><number>8</number></property>
     <item>
      <widget class="RangeSlider" name="rangeSlider">
       <!-- Full-bleed. The track is the playback scrubber's 24px height; the host
            binding grows the widget by one row for the always-on handle labels above
            it (see widget_binding RangeSlider time-span). -->
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Preferred"><horstretch>1</horstretch><verstretch>0</verstretch></sizepolicy>
       </property>
       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
     <!-- Buttons bottom-aligned to the duration widget: the slider is taller (one
          label row above its 24px track), so AlignBottom lines the buttons up with
          the track at the bottom. Fixed 24px height = the track height, so the
          buttons read as the same strip as the slider. -->
     <!-- Compact padding (2 = space_tight vertical, 8 = space_comfortable
          horizontal) so the label fits the 24px track-height box - the app's
          global QPushButton padding (8px all around) clips text at this height.
          Colors/radius still come from the app stylesheet. -->
     <item alignment="Qt::AlignBottom">
      <widget class="QPushButton" name="buttonCancel">
       <property name="text"><string>Cancel</string></property>
       <property name="minimumSize"><size><width>0</width><height>24</height></size></property>
       <property name="maximumSize"><size><width>16777215</width><height>24</height></size></property>
       <property name="styleSheet"><string notr="true">QPushButton { padding: 2px 8px; }</string></property>
      </widget>
     </item>
     <item alignment="Qt::AlignBottom">
      <widget class="QPushButton" name="buttonFetch">
       <property name="text"><string>Download</string></property>
       <property name="minimumSize"><size><width>90</width><height>24</height></size></property>
       <property name="maximumSize"><size><width>16777215</width><height>24</height></size></property>
       <property name="styleSheet"><string notr="true">QPushButton { padding: 2px 8px; }</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <!-- No in-panel status strip: connection / import / error events surface in
        the app's top notification bell (reportMessage); live download progress
        shows in the Info panel during a fetch. -->
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <buttongroups>
  <buttongroup name="topicModeGroup"/>
 </buttongroups>
</ui>
