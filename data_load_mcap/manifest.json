{
  "id": "mcap-loader",
  "name": "MCAP Loader",
  "version": "1.2.0",
  "description": "Data loader for MCAP files. Supports ROS1, ROS2, Protobuf, and JSON message encodings.",
  "author": "PlotJuggler Team",
  "publisher": "PlotJuggler",
  "website": "https://github.com/PlotJuggler/pj-official-plugins",
  "repository": "https://github.com/PlotJuggler/pj-official-plugins",
  "license": "MIT",
  "icon_url": "",
  "category": "data_loader",
  "tags": [
    "mcap",
    "file",
    "loader",
    "ros",
    "ros2",
    "protobuf"
  ],
  "file_extensions": [
    ".mcap"
  ],
  "min_sdk_required": "0.28.0",
  "sdk_floor_exceptions": {
    "setDatasetMetadata": {
      "reason": "optional: metadata display absent on hosts older than 0.32; load unaffected",
      "test": "McapDatasetMetadata.PublishDegradesGracefullyWithoutHostSlot"
    }
  },
  "min_plotjuggler_version": "4.0.0"
}
