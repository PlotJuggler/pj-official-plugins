                   <property name="flat"><bool>true</bool></property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QPushButton" name="buttonSaveCurrent">
                   <property name="minimumSize"><size><width>30</width><height>30</height></size></property>
                   <property name="maximumSize"><size><width>30</width><height>30</height></size></property>
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Save the current function in the library.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
