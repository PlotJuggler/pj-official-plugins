     <!-- ==================== Tab 2: Batch Functions ==================== -->
     <widget class="QWidget" name="tab_2">
      <attribute name="title"><string>Batch Functions</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_9">
       <item>
