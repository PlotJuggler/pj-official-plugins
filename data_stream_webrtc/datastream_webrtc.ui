        <item row="1" column="0"><widget class="QLabel" name="labelServerRow"><property name="text"><string>Server</string></property></widget></item>
        <item row="1" column="1">
         <widget class="QComboBox" name="comboBoxTransport">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>WHEP signaling is HTTP. (HTTPS is not wired in this build.)</string></property>
          <item><property name="text"><string>http://</string></property></item>
         </widget>
        </item>
        <item row="1" column="2">
         <widget class="QLineEdit" name="lineEditAddress">
          <property name="toolTip"><string>WHEP server host (mediamtx). Each selected path is read from http://&lt;address&gt;:&lt;port&gt;/&lt;path&gt;/whep.</string></property>
          <property name="placeholderText"><string>127.0.0.1</string></property>
         </widget>
        </item>
        <item row="1" column="3">
         <widget class="QLineEdit" name="lineEditPort">
          <property name="toolTip"><string>WHEP server port (mediamtx default 8889).</string></property>
          <property name="placeholderText"><string>8889</string></property>
         </widget>
        </item>
        <item row="2" column="0"><widget class="QLabel" name="labelApiRow"><property name="text"><string>Control API</string></property></widget></item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboBoxApiTransport">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Control API is HTTP. (HTTPS is not wired in this build.)</string></property>
          <item><property name="text"><string>http://</string></property></item>
         </widget>
        </item>
        <item row="2" column="2">
         <widget class="QLineEdit" name="lineEditApiAddress">
          <property name="toolTip"><string>mediamtx Control API host, used only to list paths (GET /v3/paths/list). Auto-derived from the server; edit to override, or clear to disable API discovery (manual paths still work).</string></property>
          <property name="placeholderText"><string>127.0.0.1</string></property>
         </widget>
        </item>
        <item row="2" column="3">
         <widget class="QLineEdit" name="lineEditApiPort">
          <property name="toolTip"><string>mediamtx Control API port (default 9997).</string></property>
          <property name="placeholderText"><string>9997</string></property>
         </widget>
        </item>
        <item row="2" column="4">
         <widget class="QPushButton" name="buttonRefresh">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
