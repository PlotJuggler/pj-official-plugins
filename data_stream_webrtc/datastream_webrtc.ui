        <item row="3" column="0"><widget class="QLabel" name="labelPath"><property name="text"><string>Base path</string></property></widget></item>
        <item row="3" column="1" colspan="4">
         <widget class="QLineEdit" name="lineEditPath">
          <property name="toolTip"><string>Optional base path prefix on the server (most mediamtx setups leave this empty).</string></property>
