<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DataStreamWebRTC</class>
 <widget class="QDialog" name="DataStreamWebRTC">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>620</width><height>600</height></rect>
  </property>
  <property name="minimumSize"><size><width>620</width><height>600</height></size></property>
  <property name="windowTitle"><string>WebRTC Video Client (WHEP)</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="labelServer">
     <property name="font"><font><pointsize>12</pointsize><bold>true</bold></font></property>
     <property name="text"><string>WHEP Server</string></property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayoutServer">
     <item row="0" column="0"><widget class="QLabel" name="labelServerUrl"><property name="text"><string>Server URL:</string></property></widget></item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="lineEditServerUrl">
       <property name="toolTip"><string>Base URL of the WHEP server (e.g. mediamtx). Each selected path is read from &lt;url&gt;/&lt;path&gt;/whep.</string></property>
       <property name="placeholderText"><string>http://127.0.0.1:8889</string></property>
      </widget>
     </item>
     <item row="1" column="0"><widget class="QLabel" name="labelBearer"><property name="text"><string>Bearer token:</string></property></widget></item>
     <item row="1" column="1">
      <widget class="QLineEdit" name="lineEditBearer">
       <property name="toolTip"><string>Optional. Sent as "Authorization: Bearer ..." on every WHEP and Control API request.</string></property>
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
       <property name="placeholderText"><string>(optional)</string></property>
      </widget>
     </item>
     <item row="2" column="0"><widget class="QLabel" name="labelApiUrl"><property name="text"><string>Control API URL:</string></property></widget></item>
     <item row="2" column="1">
      <layout class="QHBoxLayout" name="horizontalLayoutApi">
       <item>
        <widget class="QLineEdit" name="lineEditApiUrl">
         <property name="toolTip"><string>mediamtx Control API base URL, used only to list available paths (GET /v3/paths/list). Leave as derived default, or clear if the server has no API - manual paths still work.</string></property>
         <property name="placeholderText"><string>http://127.0.0.1:9997</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="buttonRefresh">
         <property name="minimumSize"><size><width>110</width><height>25</height></size></property>
         <property name="text"><string>Refresh list</string></property>
        </widget>
       </item>
      </layout>
     </item>
     <item row="3" column="0"><widget class="QLabel" name="labelTopicPrefix"><property name="text"><string>Topic prefix:</string></property></widget></item>
     <item row="3" column="1">
      <widget class="QLineEdit" name="lineEditTopicPrefix">
       <property name="toolTip"><string>Each selected path becomes the topic &lt;prefix&gt;/&lt;path&gt;.</string></property>
       <property name="placeholderText"><string>webrtc</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item><widget class="Line" name="lineSep1"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayoutPathsHeader">
     <item>
      <widget class="QLabel" name="labelPaths">
       <property name="font"><font><pointsize>12</pointsize><bold>true</bold></font></property>
       <property name="text"><string>Select one or multiple streams:</string></property>
      </widget>
     </item>
     <item><spacer name="horizontalSpacerPaths"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     <item><widget class="QLabel" name="labelFilter"><property name="text"><string>Filter: </string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="lineEditFilter">
       <property name="filterField" stdset="0"><bool>true</bool></property>
       <property name="maximumSize"><size><width>300</width><height>16777215</height></size></property>
       <property name="clearButtonEnabled"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="labelApiStatus">
     <property name="text"><string> </string></property>
    </widget>
   </item>
   <item>
    <widget class="QTableWidget" name="camerasList">
     <property name="toolTip"><string>Paths on the server (from the Control API) plus manually added ones. Select the streams you want; each becomes its own PJ.VideoFrame topic. Only H.264 streams are selectable.</string></property>
     <property name="selectionMode"><enum>QAbstractItemView::MultiSelection</enum></property>
     <property name="sortingEnabled"><bool>true</bool></property>
     <property name="columnCount"><number>3</number></property>
     <column><property name="text"><string>Path</string></property></column>
     <column><property name="text"><string>Tracks</string></property></column>
     <column><property name="text"><string>Ready</string></property></column>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayoutManual">
     <item><widget class="QLabel" name="labelManualPath"><property name="text"><string>Manual path:</string></property></widget></item>
     <item>
      <widget class="QLineEdit" name="lineEditManualPath">
       <property name="toolTip"><string>Add a path the Control API did not list (API disabled, or a non-mediamtx WHEP server).</string></property>
       <property name="placeholderText"><string>e.g. cam0</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="buttonAddPath">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Add</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="labelIce">
     <property name="font"><font><pointsize>12</pointsize><bold>true</bold></font></property>
     <property name="text"><string>ICE Servers (STUN / TURN)</string></property>
    </widget>
   </item>
   <item>
    <widget class="QTableWidget" name="tableIceServers">
     <property name="toolTip"><string>STUN: fill URL only (e.g. stun:stun.l.google.com:19302). TURN: also fill Username and Credential (e.g. turn:turn.example.org:3478).</string></property>
     <property name="maximumSize"><size><width>16777215</width><height>120</height></size></property>
     <property name="columnCount"><number>3</number></property>
     <column><property name="text"><string>URL</string></property></column>
     <column><property name="text"><string>Username</string></property></column>
     <column><property name="text"><string>Credential</string></property></column>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>DataStreamWebRTC</receiver><slot>accept()</slot></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>DataStreamWebRTC</receiver><slot>reject()</slot></connection>
 </connections>
