    </widget>
   </item>
   <item>
    <widget class="QWidget" name="serverWrap" native="true">
     <layout class="QVBoxLayout" name="serverWrapLayout">
      <property name="leftMargin"><number>9</number></property>
      <property name="topMargin"><number>6</number></property>
      <property name="rightMargin"><number>9</number></property>
      <property name="bottomMargin"><number>9</number></property>
      <item>
       <layout class="QGridLayout" name="gridLayoutFields" columnstretch="0,0,2,1,0">
        <property name="spacing"><number>6</number></property>
        <item row="0" column="1"><widget class="QLabel" name="labelTransport"><property name="text"><string>Transport</string></property></widget></item>
