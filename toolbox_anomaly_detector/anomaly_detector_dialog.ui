<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep this file pure ASCII: pj_embed_ui bakes it into a constexpr char[], where any
     byte above 127 is a narrowing error under -Werror. Nothing validates the XML either
     (the embed is a plain file read), so a malformed edit builds green, passes the tests
     and only fails when the dialog is opened. -->
<ui version="4.0">
 <class>AnomalyDetectorDialog</class>
 <widget class="QWidget" name="AnomalyDetectorDialog">
  <property name="windowTitle">
   <string>Anomaly Detector</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>8</number></property>
   <property name="leftMargin"><number>10</number></property>
   <property name="topMargin"><number>10</number></property>
   <property name="rightMargin"><number>10</number></property>
   <property name="bottomMargin"><number>10</number></property>

   <!-- Preview chart (top) and controls (bottom) in a user-resizable vertical splitter -->
   <item>
    <widget class="QSplitter" name="previewSplitter">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>
     <widget class="QFrame" name="preview_chart">
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch><verstretch>2</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumSize"><size><width>0</width><height>200</height></size></property>
     </widget>
     <!-- Without an explicit vertical stretch this pane gets 0 against the chart's 2,
          so the splitter hands every spare pixel to the chart and the function list
          opens clipped mid-row. -->
     <widget class="QWidget" name="controlsPane" native="true">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch><verstretch>1</verstretch>
       </sizepolicy>
      </property>
      <layout class="QVBoxLayout" name="controlsVLayout">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>4</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <layout class="QHBoxLayout" name="columnsLayout">
         <property name="spacing"><number>8</number></property>

         <!-- Source -->
         <item>
          <!-- The whole section frame is the drop target (declared from code with
               setDropTarget): the host's DropEventFilter walks up from the widget under
               the cursor, so marking the container covers the band, its filter and the
               list in one go. A bare NoFrame QFrame is what that filter resolves
               cleanly, same as toolbox_fft's inputFrame. The objectName predates the
               band migration and is kept verbatim: it is the drop contract the plugin
               and its tests speak. -->
          <widget class="QFrame" name="sourceGroup">
           <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
           <property name="frameShadow"><enum>QFrame::Plain</enum></property>
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
             <horstretch>1</horstretch><verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize"><size><width>200</width><height>0</height></size></property>
           <layout class="QVBoxLayout" name="sourceLayout">
            <property name="spacing"><number>0</number></property>
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
            <item>
             <!-- filterPlaceholder grows the host's canonical filter inside the band;
                  filterFieldName is the objectName onTextChanged() reports, kept as
                  source_filter so the plugin code is untouched. Class name without the
                  PJ:: prefix: that is how PjUiLoader registers this widget. -->
             <widget class="SectionHeaderBand" name="sourceHeader">
              <property name="text"><string>Source</string></property>
              <property name="filterPlaceholder"><string>Filter series...</string></property>
              <property name="filterFieldName"><string>source_filter</string></property>
             </widget>
            </item>
            <item>
             <widget class="QListWidget" name="source_list">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                <horstretch>0</horstretch><verstretch>1</verstretch>
               </sizepolicy>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <!-- Function -->
         <item>
          <widget class="QWidget" name="functionGroup" native="true">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
             <horstretch>1</horstretch><verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize"><size><width>200</width><height>0</height></size></property>
           <layout class="QVBoxLayout" name="functionLayout">
            <property name="spacing"><number>0</number></property>
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
            <item>
             <widget class="SectionHeaderBand" name="functionHeader">
              <property name="text"><string>Function</string></property>
             </widget>
            </item>
            <item>
             <widget class="QListWidget" name="function_list">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                <horstretch>0</horstretch><verstretch>1</verstretch>
               </sizepolicy>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <!-- Lua rule editor -->
         <item>
          <widget class="QWidget" name="editorGroup" native="true">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
             <horstretch>2</horstretch><verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize"><size><width>280</width><height>0</height></size></property>
           <layout class="QVBoxLayout" name="editorLayout">
            <property name="spacing"><number>0</number></property>
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
            <item>
             <!-- The scope selector rides this band's trailing area. Nested widgets are
                  handed to the band's own horizontal layout, which is exactly where the
                  host's radio adapter looks before swapping an exclusive group for a
                  segmented DualOptionsWidget; a group that ends up outside a box or grid
                  layout stays a row of bare radios, silently. Same shape as the Preview
                  band of data_load_csv. -->
             <widget class="SectionHeaderBand" name="editorHeader">
              <property name="text"><string>Lua rule</string></property>
              <property name="fillDockedWidgets" stdset="0"><bool>true</bool></property>
              <widget class="QRadioButton" name="scope_timeseries">
               <property name="text"><string>Timeseries</string></property>
               <property name="checked"><bool>true</bool></property>
               <property name="toolTip"><string>Markers only on the selected source series.</string></property>
               <attribute name="buttonGroup"><string>scopeGroup</string></attribute>
              </widget>
              <widget class="QRadioButton" name="scope_dataset">
               <property name="text"><string>Dataset</string></property>
               <property name="toolTip"><string>Markers on every plot of the active dataset, whatever series it shows.</string></property>
               <attribute name="buttonGroup"><string>scopeGroup</string></attribute>
              </widget>
              <widget class="QRadioButton" name="scope_global">
               <property name="text"><string>Global</string></property>
               <property name="toolTip"><string>Markers on every plot of every loaded dataset.</string></property>
               <attribute name="buttonGroup"><string>scopeGroup</string></attribute>
              </widget>
             </widget>
            </item>
            <item>
             <widget class="QPlainTextEdit" name="code_editor"/>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

   <!-- Status line -->
   <item>
    <widget class="QLabel" name="status_label">
     <property name="text"><string>Pick a source series and a function (or write your own), then Apply.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>

   <!-- Rule file + Apply / Close (right). The scope selector is NOT here: it rides the
        Lua rule band, next to the rule it scopes. -->
   <item>
    <layout class="QHBoxLayout" name="bottomBar">
     <item>
      <spacer name="bottomSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="save_rule_button">
       <property name="text"><string>Save rule as...</string></property>
       <property name="toolTip"><string>Save the current rule (script + source) as a portable JSON file</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="load_rule_button">
       <property name="text"><string>Load rule...</string></property>
       <property name="toolTip"><string>Open a rule JSON file and load it into the editor</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="apply_button">
       <property name="text"><string>Apply</string></property>
       <property name="toolTip"><string>Run the Lua rule and apply the emitted markers to the plots. Requires a source series, unless the scope is Dataset or Global.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="buttonBox">
       <property name="standardButtons"><set>QDialogButtonBox::Close</set></property>
       <property name="sizePolicy">
        <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
         <horstretch>0</horstretch><verstretch>0</verstretch>
        </sizepolicy>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <buttongroups>
  <buttongroup name="scopeGroup"/>
 </buttongroups>
</ui>
