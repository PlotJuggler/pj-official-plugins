<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ColormapDialog</class>
 <widget class="QWidget" name="ColormapDialog">
  <property name="windowTitle">
   <string>ColorMap Editor</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>0</number></property>
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>

   <!-- Two banner-headed panes, split by an adjustable separator -->
   <item>
    <widget class="QSplitter" name="columnsSplitter">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>

     <!-- Left: Saved ColorMaps -->
     <widget class="QWidget" name="savedPane">
      <layout class="QVBoxLayout" name="savedLayout">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <widget class="SectionHeaderBand" name="savedBanner">
         <property name="text"><string>Saved ColorMaps</string></property>
        </widget>
       </item>
       <item>
        <widget class="QListWidget" name="saved_list">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Ignored" vsizetype="Expanding"/>
         </property>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- Right: function ColorMap(v) -->
     <widget class="QWidget" name="functionPane">
      <layout class="QVBoxLayout" name="functionLayout">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <widget class="SectionHeaderBand" name="functionBanner">
         <property name="text"><string>function ColorMap(v)</string></property>
        </widget>
       </item>
       <item>
        <layout class="QVBoxLayout" name="functionBody">
         <property name="spacing"><number>6</number></property>
         <property name="leftMargin"><number>8</number></property>
         <property name="topMargin"><number>8</number></property>
         <property name="rightMargin"><number>8</number></property>
         <property name="bottomMargin"><number>8</number></property>
         <!-- Name spans the full width at the top; the inline height override
              beats the app's compact QLineEdit cap so it matches the Save button. -->
         <item>
          <widget class="QLineEdit" name="name_edit">
           <property name="placeholderText"><string>Colormap name</string></property>
           <property name="styleSheet"><string>QLineEdit { min-height: 24px; max-height: 24px; }</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPlainTextEdit" name="code_editor">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Ignored" vsizetype="Expanding"/>
           </property>
           <property name="placeholderText">
            <string>-- Example:
if v &gt; 0 then return "red" else return "#4488ff" end</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="status_label">
           <property name="text"><string></string></property>
          </widget>
         </item>
         <!-- Save is the primary action, pinned at the bottom of the pane. -->
         <item>
          <widget class="QPushButton" name="save_btn">
           <property name="text"><string>Save</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
