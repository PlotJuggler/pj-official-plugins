<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>QuaternionDialog</class>
 <widget class="QWidget" name="QuaternionDialog">
  <property name="windowTitle">
   <string>Quaternion to RPY</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>0</number></property>
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <!-- Draggable separator between the input/options pane (top) and the preview chart (bottom). -->
    <widget class="QSplitter" name="mainSplitter">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>
     <!-- Top pane: quaternion inputs + options. The whole frame is the drop target.
          Vertical size policy is Minimum so this pane stays compact and the chart
          below takes the remaining height. -->
     <widget class="QFrame" name="inputFrame">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <property name="frameShadow"><enum>QFrame::Plain</enum></property>
      <layout class="QVBoxLayout" name="inputFrameLayout">
       <!-- No top/bottom margin so the inputSplitter (and its drag handle) runs
            flush from the top to the bottom edge of the pane; per-pane padding
            below keeps the content off the edges. -->
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>8</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>8</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <!-- Draggable separator between the LHS quaternion inputs and the RHS settings. -->
        <widget class="QSplitter" name="inputSplitter">
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
         <property name="childrenCollapsible"><bool>false</bool></property>
         <!-- LHS: X/Y/Z/W + output prefix -->
         <widget class="QWidget" name="inputsPane">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
            <horstretch>1</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <layout class="QVBoxLayout" name="inputsColumn">
           <property name="spacing"><number>6</number></property>
           <property name="leftMargin"><number>0</number></property>
           <property name="topMargin"><number>8</number></property>
           <property name="rightMargin"><number>8</number></property>
           <property name="bottomMargin"><number>8</number></property>
           <item>
            <layout class="QFormLayout" name="formLayout">
             <property name="verticalSpacing"><number>4</number></property>
             <item row="0" column="0"><widget class="QLabel"><property name="text"><string>X:</string></property></widget></item>
             <item row="0" column="1"><widget class="QLineEdit" name="input_x"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="readOnly"><bool>true</bool></property></widget></item>
             <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Y:</string></property></widget></item>
             <item row="1" column="1"><widget class="QLineEdit" name="input_y"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="readOnly"><bool>true</bool></property></widget></item>
             <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Z:</string></property></widget></item>
             <item row="2" column="1"><widget class="QLineEdit" name="input_z"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="readOnly"><bool>true</bool></property></widget></item>
             <item row="3" column="0"><widget class="QLabel"><property name="text"><string>W:</string></property></widget></item>
             <item row="3" column="1"><widget class="QLineEdit" name="input_w"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="readOnly"><bool>true</bool></property></widget></item>
             <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Output:</string></property></widget></item>
             <item row="4" column="1"><widget class="QLineEdit" name="output_prefix"><property name="placeholderText"><string>e.g. /imu/rpy/</string></property></widget></item>
            </layout>
           </item>
          </layout>
         </widget>
         <!-- RHS: settings (angle units + unwrap) -->
         <widget class="QWidget" name="settingsPane">
          <property name="minimumSize"><size><width>170</width><height>0</height></size></property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <layout class="QVBoxLayout" name="optionsColumn">
           <property name="spacing"><number>8</number></property>
           <property name="leftMargin"><number>8</number></property>
           <property name="topMargin"><number>8</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>8</number></property>
           <item>
            <!-- Exclusive pair in a horizontal group: the host adapts it into a
                 segmented DualOptionsWidget (matching the other toolbox dialogs). -->
            <layout class="QHBoxLayout" name="angleRow">
             <property name="spacing"><number>0</number></property>
             <item>
              <widget class="QRadioButton" name="radio_radians">
               <property name="text"><string>Radians</string></property>
               <attribute name="buttonGroup"><string>angleGroup</string></attribute>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="radio_degrees">
               <property name="text"><string>Degrees</string></property>
               <property name="checked"><bool>true</bool></property>
               <attribute name="buttonGroup"><string>angleGroup</string></attribute>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QCheckBox" name="unwrap_check">
             <property name="text"><string>Unwrap Angles</string></property>
             <property name="checked"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <spacer name="optionsSpacer">
             <property name="orientation"><enum>Qt::Vertical</enum></property>
             <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="status_label">
             <property name="text"><string></string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <!-- Save anchored at the bottom of the settings column, with padding. -->
            <layout class="QVBoxLayout" name="saveWrap">
             <property name="leftMargin"><number>0</number></property>
             <property name="topMargin"><number>8</number></property>
             <property name="rightMargin"><number>0</number></property>
             <property name="bottomMargin"><number>8</number></property>
             <item>
              <widget class="QPushButton" name="save_button">
               <property name="text"><string>Save</string></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Bottom pane: preview chart (borderless). Empty-state hint set via setChartPlaceholder. -->
     <widget class="QFrame" name="chart_preview">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>1</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumSize">
       <size><width>0</width><height>150</height></size>
      </property>
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <property name="frameShadow"><enum>QFrame::Plain</enum></property>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <buttongroups>
  <buttongroup name="angleGroup"/>
 </buttongroups>
</ui>
